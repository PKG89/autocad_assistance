{
    admin off
    auto_https disable_redirects
}

https://__PILOT_FQDN__ {
    bind __VPN_IP__
    tls /etc/geoai-pilot/tls/cert.pem /etc/geoai-pilot/tls/key.pem
    reverse_proxy 127.0.0.1:18460 {
        header_up Host {host}
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
    }
}
